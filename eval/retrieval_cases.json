{
  "dataset_version": "r6-retrieval-v1",
  "provenance": "R6 authored synthetic traveler questions; official R3 documents define gold; not field traffic or human-certified facts",
  "split_policy": "Question families disjoint. Dev selects threshold; holdout evaluated once at selected threshold. R3 legacy 44 diagnostic only. Frozen before first scoring.",
  "selection_policy": {
    "candidates": [
      0.1,
      0.15,
      0.2,
      0.25,
      0.3,
      0.35,
      0.4,
      0.45,
      0.5,
      0.55,
      0.6
    ],
    "k": 3,
    "relative_cutoff": 0.5,
    "objective": "2*positive_top3 / (2*positive_top3 + positive_misses + 2*out_of_scope_nonempty)",
    "tie_break": "fewer out-of-scope false positives, then lower min_score",
    "release_gate": {
      "positive_top3_recall_min": 0.9,
      "out_of_scope_false_positives_max": 0
    }
  },
